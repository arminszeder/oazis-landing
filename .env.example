# Supabase — Project Settings → API → Project URL
# Must be the API host, not the dashboard link you see in the address bar.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key, from the same page. Server-only: never prefix it with
# NEXT_PUBLIC_. Put the real value in .env.local (gitignored), never here.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Shared password for the organiser dashboard at /admin. Anything long enough
# to type on a phone but not guessable: `openssl rand -base64 12`. Changing it
# signs everyone out, which is how you revoke access.
ADMIN_PASSWORD=
