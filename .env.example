# Supabase — Project Settings → API → Project URL
# Must be the API host, not the dashboard link you see in the address bar.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key, from the same page. Server-only: never prefix it with
# NEXT_PUBLIC_. Put the real value in .env.local (gitignored), never here.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
